# ── Database ────────────────────────────────────────────────────
# Local development (docker-compose):
DATABASE_URL=postgresql+asyncpg://quant:quant@localhost:5432/quant

# Supabase (production):
# DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# ── Auth (Supabase) ─────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Set to false for local dev without auth
AUTH_ENABLED=true

# ── Paths ────────────────────────────────────────────────────────
# Absolute path to the website/data directory (JSON outputs from main.py)
QUANT_DATA_DIR=./website/data

# ── API ──────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
API_HOST=0.0.0.0
API_PORT=8000

# ── Scheduler ────────────────────────────────────────────────────
# Cron expression for daily quant run (06:00 ET = 11:00 UTC)
SCHEDULER_CRON=0 11 * * *
SCHEDULER_ENABLED=true
